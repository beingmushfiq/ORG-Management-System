{
  "name": "org-management-system",
  "version": "0.1.0",
  "description": "Enterprise multi-tenant SaaS for institutional bodies, professional syndicates, and civic foundations in Bangladesh. Features 4-layer tenant isolation, BigInt paisa ledger (EPS, bKash, Nagad), 3D WebGL branch galaxy, 64-district atlas, hybrid elections, and statutory Societies Act 1860 compliance.",
  "author": "DevCenterPoint <https://devcenterpoint.com>",
  "homepage": "https://devcenterpoint.com",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@org/web...",
    "build:api": "turbo run build --filter=@org/api...",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@org/web...",
    "dev:api": "turbo run dev --filter=@org/api...",
    "lint": "turbo run lint",
    "lint:web": "turbo run lint --filter=@org/web...",
    "lint:api": "turbo run lint --filter=@org/api...",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "turbo run typecheck --filter=@org/web...",
    "typecheck:api": "turbo run typecheck --filter=@org/api...",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.5.2",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.5.1"
}
