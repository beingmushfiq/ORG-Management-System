# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES — Organization Management SaaS (@org/web)
# For Vercel deployments, configure these in Project Settings -> Environment Variables.
# ==============================================================================

# Public API URL (Proxied by Next.js rewrites at /api/*)
# In production on Vercel, set this to your deployed backend API URL (e.g., https://api.yourdomain.com)
# In local development, defaults to http://localhost:4000
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Optional backend URL used by Next.js server-side rewrites (if different from public URL)
API_URL="http://localhost:4000"

# Default fallback tenant slug (used on primary domain or root vercel.app preview URL)
# Example: "bma-ctg" or "rsm-bd"
NEXT_PUBLIC_DEFAULT_TENANT="bma-ctg"

# Platform Base Domain (used for tenant subdomain resolution)
NEXT_PUBLIC_PLATFORM_DOMAIN="localhost:3000"
