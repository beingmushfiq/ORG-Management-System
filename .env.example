# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — Organization Management SaaS
# Copy this file to .env and configure local secrets
# ==============================================================================

NODE_ENV=development
PORT=4000
PLATFORM_DOMAIN=localhost:3000

# ------------------------------------------------------------------------------
# DATABASE (MySQL 8.0)
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://saas_user:saas_password_local@localhost:3306/org_management_saas"

# ------------------------------------------------------------------------------
# REDIS (Cache & BullMQ)
# ------------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# S3 / R2 STORAGE (Presigned Uploads)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="r2" # or s3
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_NAME="org-saas-media"
STORAGE_PUBLIC_URL="https://assets.yourplatform.com"

# ------------------------------------------------------------------------------
# BANGLADESH PAYMENT GATEWAYS (Global / Fallback credentials)
# ------------------------------------------------------------------------------
# EPS (Electronic Payment System — https://www.eps.com.bd/)
EPS_MERCHANT_ID=""
EPS_API_KEY=""
EPS_BASE_URL="https://api.eps.com.bd"

# bKash Checkout
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

# Nagad
NAGAD_MERCHANT_ID=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""
NAGAD_BASE_URL="http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs"

# SSLCommerz
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWD=""
SSLCOMMERZ_IS_SANDBOX=true

# ------------------------------------------------------------------------------
# COMMUNICATIONS
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
DEFAULT_FROM_EMAIL="noreply@yourplatform.com"
